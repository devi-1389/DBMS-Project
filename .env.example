# Copy to .env.local (git-ignored) and fill in values. Never commit real values.

# Neon PostgreSQL, from a development branch (never production).
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL=
# Direct (unpooled) connection string, used for migrations and seeding.
DATABASE_URL_UNPOOLED=

# Only for `npm run db:test:concurrency`: a disposable, already-migrated database.
TEST_DATABASE_URL=

# Clerk authentication (Clerk Dashboard → API keys). See docs/AUTHENTICATION.md.
# Only the publishable key may be public. Without both keys sign-in stays disabled and
# protected routes redirect to /login, which shows setup instructions. Sign-in and
# sign-up URLs are set in code (lib/auth/config.ts), not here.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: signing secret of the webhook endpoint /api/webhooks/clerk, which keeps
# profile updates and account deletions in sync.
CLERK_WEBHOOK_SIGNING_SECRET=
