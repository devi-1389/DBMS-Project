# SOLACE Resort Experience Management System - environment configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
# Generate your own key, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value
HOST=127.0.0.1
PORT=5000
# Set to 1 only when the site is served over HTTPS (switched on automatically on Vercel)
SESSION_COOKIE_SECURE=0
SESSION_LIFETIME_MINUTES=120

# MySQL Database Configuration (XAMPP / local MySQL defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=solace_db

# --- Hosted (cloud) MySQL - needed for Vercel; leave these out on your own PC -----------------
# One connection string instead of the five DB_* values above (it wins when both are set):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Encrypted connection (most hosted MySQL servers require it):
# DB_SSL=1
# Optional - also verify the server certificate with the CA certificate your MySQL host provides:
# DB_SSL_CA=certs/ca.pem
# Local time of the resort as a UTC offset (hosting servers run on UTC). India = +05:30
# APP_UTC_OFFSET=+05:30
# ----------------------------------------------------------------------------------------------

# Automated tests rebuild this separate database (must differ from DB_NAME)
TEST_DB_NAME=solace_test_db

# SQL Query Laboratory limits (Database Explorer, administrators only)
SQL_LAB_ROW_LIMIT=500
SQL_LAB_TIMEOUT_MS=5000

# Recommendation Weights (Sum = 1.0)
WEIGHT_INTEREST=0.40
WEIGHT_BUDGET=0.25
WEIGHT_SCHEDULE=0.15
WEIGHT_SUSTAINABILITY=0.10
WEIGHT_RATING=0.10
