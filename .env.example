# Copy to .env.local (git-ignored) and fill in values. Never commit real values.

# Neon PostgreSQL, from a development branch (never production).
# Pooled connection string (host contains "-pooler"), used by the app at runtime.
DATABASE_URL=
# Direct (unpooled) connection string, used for migrations and seeding.
DATABASE_URL_UNPOOLED=

# Only for `npm run db:test:concurrency`: a disposable, already-migrated database.
TEST_DATABASE_URL=
